digraph "sof_ipc_stream_map"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="sof_ipc_stream_map",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Complete map for each channel of a multichannel stream."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" ch_map" ];
  Node2 [label="sof_ipc_channel_map",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsof__ipc__channel__map.html",tooltip="Channel map, specifies transformation of one-to-many or many-to-one."];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hdr" ];
  Node3 [label="sof_ipc_cmd_hdr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsof__ipc__cmd__hdr.html",tooltip=" "];
}

digraph "snd_sf_sample"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="snd_sf_sample",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node1 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" v" ];
  Node2 [label="soundfont_sample_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsoundfont__sample__info.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" block" ];
  Node3 [label="snd_util_memblk",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsnd__util__memblk.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list" ];
  Node4 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node4 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
}

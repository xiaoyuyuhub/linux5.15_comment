  Node7 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" clk_get_rate" ];
  Node7 [label="cmd_clk_get_rate_response",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__clk__get__rate__response.html",tooltip=" "];

digraph "sg_append_table"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="sg_append_table",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prv" ];
  Node2 [label="scatterlist",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structscatterlist.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sgt" ];
  Node3 [label="sg_table",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsg__table.html",tooltip=" "];
  Node2 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sgl" ];
}

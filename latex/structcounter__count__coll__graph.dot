digraph "counter_count"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="counter_count",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" functions_list" ];
  Node2 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" ext" ];
  Node3 [label="counter_count_ext",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcounter__count__ext.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" synapses" ];
  Node4 [label="counter_synapse",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcounter__synapse.html",tooltip=" "];
  Node2 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" actions_list" ];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" signal" ];
  Node5 [label="counter_signal",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcounter__signal.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" ext" ];
  Node6 [label="counter_signal_ext",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcounter__signal__ext.html",tooltip=" "];
}

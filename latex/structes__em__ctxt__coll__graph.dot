digraph "es_em_ctxt"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="es_em_ctxt",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" insn" ];
  Node2 [label="insn",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structinsn.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" vex_prefix\nimmediate1\nimmediate2\nmoffset1\nsib\nrex_prefix\nmoffset2\nmodrm\nimmediate\nprefixes\n..." ];
  Node3 [label="insn_field",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structinsn__field.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" regs" ];
  Node4 [label="pt_regs",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structpt__regs.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fi" ];
  Node5 [label="es_fault_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structes__fault__info.html",tooltip=" "];
}

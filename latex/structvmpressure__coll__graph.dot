digraph "vmpressure"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="vmpressure",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" events" ];
  Node2 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sr_lock" ];
  Node3 [label="spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structspinlock.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" rlock" ];
  Node4 [label="raw_spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structraw__spinlock.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node5 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node6 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node7 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" events_lock" ];
  Node7 [label="mutex",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmutex.html",tooltip=" "];
  Node2 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_list" ];
  Node4 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_lock" ];
  Node6 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" owner" ];
  Node8 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" work" ];
  Node8 [label="work_struct",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structwork__struct.html",tooltip=" "];
  Node2 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" entry" ];
  Node8 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" func" ];
  Node6 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" data" ];
}

  Node2 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" patterns" ];
  Node3 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node3 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" rssi" ];
  Node4 [label="adv_rssi_thresholds",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structadv__rssi__thresholds.html",tooltip=" "];
}

digraph "udp_table"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="udp_table",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hash2\nhash" ];
  Node2 [label="udp_hslot",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structudp__hslot.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];
  Node3 [label="spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structspinlock.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" rlock" ];
  Node4 [label="raw_spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structraw__spinlock.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node5 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node6 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node7 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" head" ];
  Node7 [label="hlist_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structhlist__head.html",tooltip=" "];
  Node8 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" first" ];
  Node8 [label="hlist_node",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structhlist__node.html",tooltip=" "];
  Node8 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next\npprev" ];
}

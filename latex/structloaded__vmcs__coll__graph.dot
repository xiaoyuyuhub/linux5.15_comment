digraph "loaded_vmcs"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="loaded_vmcs",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" loaded_vmcss_on_cpu_link" ];
  Node2 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" vmcs\nshadow_vmcs" ];
  Node3 [label="vmcs",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structvmcs.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hdr" ];
  Node4 [label="vmcs_hdr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structvmcs__hdr.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" controls_shadow" ];
  Node5 [label="vmcs_controls_shadow",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structvmcs__controls__shadow.html",tooltip=" "];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" host_state" ];
  Node6 [label="vmcs_host_state",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structvmcs__host__state.html",tooltip=" "];
}

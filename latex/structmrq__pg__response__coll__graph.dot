digraph "mrq_pg_response"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="mrq_pg_response",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Response to MRQ_PG."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" get_state" ];
  Node2 [label="cmd_pg_get_state_response",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__pg__get__state__response.html",tooltip="Response data to MRQ_PG sub command CMD_PG_GET_STATE."];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" get_name" ];
  Node3 [label="cmd_pg_get_name_response",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__pg__get__name__response.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" get_max_id" ];
  Node4 [label="cmd_pg_get_max_id_response",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__pg__get__max__id__response.html",tooltip=" "];
}

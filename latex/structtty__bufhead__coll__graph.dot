  Node10 [label="work_struct",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structwork__struct.html",tooltip=" "];
  Node5 -> Node10 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" entry" ];
  Node10 -> Node10 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" func" ];
  Node8 -> Node10 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" data" ];
  Node8 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" priority\nmem_used" ];

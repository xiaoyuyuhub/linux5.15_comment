digraph "scan_control"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="scan_control",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" reclaim_state" ];
  Node2 [label="reclaim_state",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structreclaim__state.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" nodemask" ];
  Node3 [label="nodemask_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structnodemask__t.html",tooltip=" "];
}

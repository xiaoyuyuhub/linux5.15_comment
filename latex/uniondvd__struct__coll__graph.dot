digraph "dvd_struct"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="dvd_struct",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" manufact" ];
  Node2 [label="dvd_manufact",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdvd__manufact.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" copyright" ];
  Node3 [label="dvd_copyright",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdvd__copyright.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" physical" ];
  Node4 [label="dvd_physical",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdvd__physical.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" layer" ];
  Node5 [label="dvd_layer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdvd__layer.html",tooltip=" "];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" disckey" ];
  Node6 [label="dvd_disckey",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdvd__disckey.html",tooltip=" "];
  Node7 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" bca" ];
  Node7 [label="dvd_bca",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdvd__bca.html",tooltip=" "];
}

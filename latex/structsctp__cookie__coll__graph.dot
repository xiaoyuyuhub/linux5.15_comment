  Node2 [label="sctp_init_chunk",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsctp__init__chunk.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" init_hdr" ];
  Node3 [label="sctp_inithdr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsctp__inithdr.html",tooltip=" "];
  Node4 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" chunk_hdr" ];
  Node4 [label="sctp_chunkhdr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsctp__chunkhdr.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" peer_addr" ];
  Node5 [label="sctp_addr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$unionsctp__addr.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sa" ];

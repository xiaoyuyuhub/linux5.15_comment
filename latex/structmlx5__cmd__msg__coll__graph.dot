digraph "mlx5_cmd_msg"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="mlx5_cmd_msg",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list" ];
  Node2 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" parent" ];
  Node3 [label="cmd_msg_cache",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__msg__cache.html",tooltip=" "];
  Node2 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" head" ];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];
  Node4 [label="spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structspinlock.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" rlock" ];
  Node5 [label="raw_spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structraw__spinlock.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node6 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node7 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node7 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node8 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
  Node8 [label="mlx5_cmd_mailbox",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmlx5__cmd__mailbox.html",tooltip=" "];
  Node8 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
  Node9 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" first" ];
  Node9 [label="mlx5_cmd_first",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmlx5__cmd__first.html",tooltip=" "];
}

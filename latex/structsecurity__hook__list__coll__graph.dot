digraph "security_hook_list"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="security_hook_list",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hook" ];
  Node2 [label="security_list_options",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$unionsecurity__list__options.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" head" ];
  Node3 [label="hlist_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structhlist__head.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" first" ];
  Node4 [label="hlist_node",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structhlist__node.html",tooltip=" "];
  Node4 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next\npprev" ];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list" ];
}

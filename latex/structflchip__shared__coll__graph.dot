digraph "flchip_shared"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="flchip_shared",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" erasing\nwriting" ];
  Node2 [label="flchip",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structflchip.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" mutex" ];
  Node3 [label="mutex",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmutex.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_list" ];
  Node4 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node4 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node5 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_lock" ];
  Node5 [label="raw_spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structraw__spinlock.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node6 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node7 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node7 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node7 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" owner" ];
  Node8 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wq" ];
  Node8 [label="wait_queue_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structwait__queue__head.html",tooltip=" "];
  Node4 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" head" ];
  Node9 -> Node8 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];
  Node9 [label="spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structspinlock.html",tooltip=" "];
  Node5 -> Node9 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" rlock" ];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];
}

digraph "net_dm_user_msg"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="net_dm_user_msg",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" user" ];
  Node2 [label="net_dm_config_msg",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structnet__dm__config__msg.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" options" ];
  Node3 [label="net_dm_config_entry",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structnet__dm__config__entry.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" alert" ];
  Node4 [label="net_dm_alert_msg",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structnet__dm__alert__msg.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" points" ];
  Node5 [label="net_dm_drop_point",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structnet__dm__drop__point.html",tooltip=" "];
}

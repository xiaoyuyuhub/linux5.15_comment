  Node7 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node7 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node8 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node8 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node8 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" owner" ];
}

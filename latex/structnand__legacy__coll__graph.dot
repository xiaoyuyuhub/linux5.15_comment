  Node3 [label="nand_controller_ops",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structnand__controller__ops.html",tooltip=" "];
  Node4 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];
  Node4 [label="mutex",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmutex.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_list" ];
  Node5 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node5 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node6 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_lock" ];

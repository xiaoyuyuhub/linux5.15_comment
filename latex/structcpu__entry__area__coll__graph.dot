digraph "cpu_entry_area"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="cpu_entry_area",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cpu_debug_buffers" ];
  Node2 [label="debug_store_buffers",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdebug__store__buffers.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" entry_stack_page" ];
  Node3 [label="entry_stack_page",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structentry__stack__page.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" stack" ];
  Node4 [label="entry_stack",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structentry__stack.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" tss" ];
  Node5 [label="tss_struct",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structtss__struct.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" io_bitmap" ];
  Node6 [label="x86_io_bitmap",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structx86__io__bitmap.html",tooltip=" "];
  Node7 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" x86_tss" ];
  Node7 [label="x86_hw_tss",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structx86__hw__tss.html",tooltip=" "];
  Node8 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cpu_debug_store" ];
  Node8 [label="debug_store",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdebug__store.html",tooltip=" "];
}

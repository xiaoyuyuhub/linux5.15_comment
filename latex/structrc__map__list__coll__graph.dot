  Node4 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node5 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];

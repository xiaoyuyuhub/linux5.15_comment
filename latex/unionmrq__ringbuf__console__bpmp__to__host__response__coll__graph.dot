digraph "mrq_ringbuf_console_bpmp_to_host_response"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node1 [label="mrq_ringbuf_console\l_bpmp_to_host_response",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Host->BPMP reply data."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" read" ];
  Node2 [label="cmd_ringbuf_console\l_read_resp",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__ringbuf__console__read__resp.html",tooltip="BPMP->Host response data for request type CMD_RINGBUF_CONSOLE_READ."];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" query_abi" ];
  Node3 [label="cmd_ringbuf_console\l_query_abi_resp",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" write" ];
  Node4 [label="cmd_ringbuf_console\l_write_resp",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__ringbuf__console__write__resp.html",tooltip="BPMP->Host response data for request type CMD_RINGBUF_CONSOLE_WRITE."];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" get_fifo" ];
  Node5 [label="cmd_ringbuf_console\l_get_fifo_resp",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__ringbuf__console__get__fifo__resp.html",tooltip="BPMP->Host reply data for request type CMD_RINGBUF_CONSOLE_GET_FIFO."];
}

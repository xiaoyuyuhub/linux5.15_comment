  Node2 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" vcpu\nvctrl" ];
  Node3 [label="resource",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structresource.html",tooltip=" "];
  Node3 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sibling\nchild\nparent" ];
}

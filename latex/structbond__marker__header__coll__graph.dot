digraph "bond_marker_header"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="bond_marker_header",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" marker" ];
  Node2 [label="bond_marker",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structbond__marker.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" requester_system" ];
  Node3 [label="mac_addr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmac__addr.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hdr" ];
  Node4 [label="ethhdr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structethhdr.html",tooltip=" "];
}

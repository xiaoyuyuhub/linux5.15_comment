digraph "mrq_debug_request"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node1 [label="mrq_debug_request",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Request with MRQ_DEBUG."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fcl" ];
  Node2 [label="cmd_debug_fclose_request",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__debug__fclose__request.html",tooltip="Parameters for CMD_DEBUG_CLOSE command."];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fwr" ];
  Node3 [label="cmd_debug_fwrite_request",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__debug__fwrite__request.html",tooltip="Parameters for CMD_DEBUG_WRITE command."];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fop" ];
  Node4 [label="cmd_debug_fopen_request",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__debug__fopen__request.html",tooltip="Parameters for CMD_DEBUG_OPEN command."];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" frd" ];
  Node5 [label="cmd_debug_fread_request",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcmd__debug__fread__request.html",tooltip="Parameters for CMD_DEBUG_READ command."];
}

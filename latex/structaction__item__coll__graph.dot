digraph "action_item"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="action_item",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" expect_delta\naction\nexpect_root" ];
  Node2 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" expect_stats" ];
  Node3 [label="expect_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structexpect__stats.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" info" ];
  Node4 [label="expect_stats_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structexpect__stats__info.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" stats" ];
  Node5 [label="objagg_obj_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structobjagg__obj__stats.html",tooltip=" "];
}

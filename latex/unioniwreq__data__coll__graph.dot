  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" essid\ndata\nencoding" ];
  Node2 [label="iw_point",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structiw__point.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" addr\nap_addr" ];
  Node3 [label="sockaddr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsockaddr.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" qual" ];
  Node4 [label="iw_quality",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structiw__quality.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" retry\nfrag\ntxpower\nnwid\nparam\nsens\nrts\nbitrate\npower" ];
  Node5 [label="iw_param",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structiw__param.html",tooltip=" "];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" freq" ];
  Node6 [label="iw_freq",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structiw__freq.html",tooltip=" "];
}

  Node2 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" link" ];
  Node5 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fn" ];
  Node7 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" regex" ];
  Node7 [label="regex",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structregex.html",tooltip=" "];
  Node7 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" match" ];
}

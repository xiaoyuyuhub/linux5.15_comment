  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" filter" ];
  Node3 [label="event_filter",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structevent__filter.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prog" ];
  Node4 [label="prog_entry",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structprog__entry.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" pred" ];
  Node5 [label="filter_pred",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structfilter__pred.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" field" ];

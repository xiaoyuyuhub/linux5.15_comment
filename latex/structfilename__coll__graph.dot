digraph "filename"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="filename",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" aname" ];
  Node2 [label="audit_names",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structaudit__names.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list" ];
  Node3 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node3 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node4 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" uid" ];
  Node4 [label="kuid_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structkuid__t.html",tooltip=" "];
  Node5 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fcap" ];
  Node5 [label="audit_cap_data",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structaudit__cap__data.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" permitted\ninheritable\nambient\neffective" ];
  Node6 [label="kernel_cap_struct",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structkernel__cap__struct.html",tooltip=" "];
  Node4 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" rootid" ];
  Node7 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" gid" ];
  Node7 [label="kgid_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structkgid__t.html",tooltip=" "];
  Node1 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" name" ];
}

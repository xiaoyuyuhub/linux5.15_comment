  Node2 [label="coda_vattr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcoda__vattr.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" va_ctime\nva_mtime\nva_atime" ];
  Node3 [label="coda_timespec",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcoda__timespec.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" oh" ];
  Node4 [label="coda_out_hdr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcoda__out__hdr.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" VFid" ];
  Node5 [label="CodaFid",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structCodaFid.html",tooltip=" "];
}

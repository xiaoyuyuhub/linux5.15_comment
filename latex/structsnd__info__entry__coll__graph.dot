digraph "snd_info_entry"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="snd_info_entry",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list\nchildren" ];
  Node2 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" access" ];
  Node3 [label="mutex",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmutex.html",tooltip=" "];
  Node2 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_list" ];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_lock" ];
  Node4 [label="raw_spinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structraw__spinlock.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node5 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node6 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node6 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" owner" ];
  Node7 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" ops" ];
  Node7 [label="snd_info_entry_ops",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsnd__info__entry__ops.html",tooltip=" "];
  Node8 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" text" ];
  Node8 [label="snd_info_entry_text",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsnd__info__entry__text.html",tooltip=" "];
  Node1 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" parent" ];
}

digraph "brcm_message"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="brcm_message",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" src\ndst" ];
  Node2 [label="scatterlist",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structscatterlist.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" type" ];
  Node3 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cmds" ];
  Node4 [label="brcm_sba_command",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structbrcm__sba__command.html",tooltip=" "];
  Node1 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" msgs" ];
}

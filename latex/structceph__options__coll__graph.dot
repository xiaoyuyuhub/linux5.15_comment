  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" mon_addr\nmy_addr" ];
  Node5 [label="ceph_entity_addr",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structceph__entity__addr.html",tooltip=" "];

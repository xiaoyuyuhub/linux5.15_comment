digraph "objagg_tmp_graph"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="objagg_tmp_graph",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" nodes" ];
  Node2 [label="objagg_tmp_node",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structobjagg__tmp__node.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" objagg_obj" ];
  Node3 [label="objagg_obj",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structobjagg__obj.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list" ];
  Node4 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node4 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node3 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" parent" ];
  Node5 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" ht_node" ];
  Node5 [label="rhash_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structrhash__head.html",tooltip=" "];
  Node5 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
  Node6 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" stats" ];
  Node6 [label="objagg_obj_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structobjagg__obj__stats.html",tooltip=" "];
}

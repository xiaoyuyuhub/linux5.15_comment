digraph "snd_soundfont"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="snd_soundfont",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" samples" ];
  Node2 [label="snd_sf_sample",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsnd__sf__sample.html",tooltip=" "];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" v" ];
  Node3 [label="soundfont_sample_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsoundfont__sample__info.html",tooltip=" "];
  Node4 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" block" ];
  Node4 [label="snd_util_memblk",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsnd__util__memblk.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" list" ];
  Node5 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node5 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" zones" ];
  Node6 [label="snd_sf_zone",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsnd__sf__zone.html",tooltip=" "];
  Node2 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sample" ];
  Node7 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" v" ];
  Node7 [label="soundfont_voice_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsoundfont__voice__info.html",tooltip=" "];
  Node8 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" parm" ];
  Node8 [label="soundfont_voice_parm",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsoundfont__voice__parm.html",tooltip=" "];
  Node6 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next_instr\nnext_zone\nnext" ];
  Node1 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
}

digraph "paravirt_patch_template"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="paravirt_patch_template",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" irq" ];
  Node2 [label="pv_irq_ops",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structpv__irq__ops.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" lock" ];
  Node3 [label="pv_lock_ops",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structpv__lock__ops.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" queued_spin_unlock\nvcpu_is_preempted" ];
  Node4 [label="paravirt_callee_save",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structparavirt__callee__save.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" mmu" ];
  Node5 [label="pv_mmu_ops",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structpv__mmu__ops.html",tooltip=" "];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cpu" ];
  Node6 [label="pv_cpu_ops",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structpv__cpu__ops.html",tooltip=" "];
}

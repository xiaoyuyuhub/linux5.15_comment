digraph "dtv_property"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="dtv_property",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" st" ];
  Node2 [label="dtv_fe_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdtv__fe__stats.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" stat" ];
  Node3 [label="dtv_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdtv__stats.html",tooltip=" "];
}

  Node1 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" mm" ];
  Node2 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" node_list\nhole_stack" ];

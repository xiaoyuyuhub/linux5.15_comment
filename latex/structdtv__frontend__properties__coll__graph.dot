digraph "dtv_frontend_properties"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="dtv_frontend_properties",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" pilot\nguard_interval\nvoltage\ndelivery_system\nrolloff\nfec_inner\nsectone\nmodulation\ncode_rate_HP\ninversion\n..." ];
  Node2 [label="enum",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$interfaceenum.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" pre_bit_error\ncnr\npost_bit_error\npre_bit_count\npost_bit_count\nstrength\nblock_error\nblock_count" ];
  Node3 [label="dtv_fe_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdtv__fe__stats.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" stat" ];
  Node4 [label="dtv_stats",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdtv__stats.html",tooltip=" "];
}

digraph "cld_clntinfo"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="cld_clntinfo",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cc_name" ];
  Node2 [label="cld_name",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcld__name.html",tooltip=" "];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cc_princhash" ];
  Node3 [label="cld_princhash",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcld__princhash.html",tooltip=" "];
}

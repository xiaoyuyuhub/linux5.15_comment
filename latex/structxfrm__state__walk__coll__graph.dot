digraph "xfrm_state_walk"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="xfrm_state_walk",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" all" ];
  Node2 [label="list_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structlist__head.html",tooltip=" "];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" prev\nnext" ];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" filter" ];
  Node3 [label="xfrm_address_filter",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structxfrm__address__filter.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" saddr\ndaddr" ];
  Node4 [label="xfrm_address_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$unionxfrm__address__t.html",tooltip=" "];
}

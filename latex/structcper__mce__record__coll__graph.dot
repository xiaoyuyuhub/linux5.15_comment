digraph "cper_mce_record"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="cper_mce_record",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" sec_hdr" ];
  Node2 [label="cper_section_descriptor",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcper__section__descriptor.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" fru_id\nsection_type" ];
  Node3 [label="guid_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structguid__t.html",tooltip=" "];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" mce" ];
  Node4 [label="mce",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structmce.html",tooltip=" "];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hdr" ];
  Node5 [label="cper_record_header",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structcper__record__header.html",tooltip=" "];
  Node3 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" notification_type\nplatform_id\npartition_id\ncreator_id" ];
}

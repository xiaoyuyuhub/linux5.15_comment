  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" forward\nextent\nreverse" ];
  Node2 [label="uid_gid_extent",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structuid__gid__extent.html",tooltip=" "];
}

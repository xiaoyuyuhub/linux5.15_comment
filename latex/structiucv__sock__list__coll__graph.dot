  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" raw_lock" ];
  Node3 [label="qrwlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqrwlock.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wait_lock" ];
  Node4 [label="qspinlock",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structqspinlock.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" val" ];
  Node5 [label="atomic_t",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structatomic__t.html",tooltip=" "];
  Node5 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" cnts" ];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" head" ];
  Node6 [label="hlist_head",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structhlist__head.html",tooltip=" "];
  Node7 -> Node6 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" first" ];
  Node7 [label="hlist_node",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structhlist__node.html",tooltip=" "];
  Node7 -> Node7 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next\npprev" ];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" autobind_name" ];
}

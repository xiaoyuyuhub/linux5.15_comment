digraph "printk_record"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="printk_record",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" info" ];
  Node2 [label="printk_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structprintk__info.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" dev_info" ];
  Node3 [label="dev_printk_info",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structdev__printk__info.html",tooltip=" "];
}
